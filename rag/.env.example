# 智谱 AI API Key（用于 Embedding + LLM 对话）
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter API Key（备选 LLM）
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM 配置
# LLM_PROVIDER: zhipu（默认，用免费额度）或 openrouter
# LLM_MODEL:
#   智谱: glm-4-flash（免费）, glm-4-plus
#   OpenRouter: deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4-flash

# ── QQ 官方机器人（https://q.qq.com/）──
# 管理端事件选 WebSocket，勾选 GROUP_AT_MESSAGE_CREATE、C2C_MESSAGE_CREATE
QQ_APP_ID=your_qq_app_id_here
QQ_APP_SECRET=your_qq_app_secret_here
# 1=只回声、不加载知识库（先跑通通道）；正式问答保持 0 或不填
QQ_ECHO_ONLY=0
# 群 openid 白名单，逗号分隔；空=不限制（沙箱可先空）
QQ_ENABLED_GROUPS=
# RAG 并发上限（第一版建议 2）
QQ_MAX_CONCURRENCY=2
